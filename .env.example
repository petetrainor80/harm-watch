# Supabase — project URL and anon key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key — SERVER SIDE ONLY. Never expose in the client bundle.
# CI verifies this key is absent from the built bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare Turnstile — site key is public, secret key is server only
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# HMAC pepper for IP hashing. Rotating this pepper resets throttle continuity by design.
IP_HMAC_PEPPER=a-long-random-secret

# Resend — transactional email
RESEND_API_KEY=re_your_key

# Rate limiting — choose one: Upstash Redis (recommended) or Postgres table
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# Sentry error tracking
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn

# App base URL (used for email links and API docs)
NEXT_PUBLIC_APP_URL=https://www.harm.watch
